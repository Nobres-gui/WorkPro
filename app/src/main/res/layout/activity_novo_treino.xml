<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".EditarTreinoActivity"
    android:background="@color/cor_azul">

    <LinearLayout
        android:id="@+id/btn_voltar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="#00000000"
        android:backgroundTint="@color/cor_branca"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        android:layout_marginLeft="20dp"
        android:layout_marginTop="10dp">
        <ImageView
            android:layout_width="30dp"
            android:layout_height="20dp"
            android:src="@drawable/de_volta"/>
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Voltar"
            android:textSize="20sp"
            android:textColor="@color/cor_branca"
            />
    </LinearLayout>

    <!--Editar Titulo Treino-->
    <ImageView
        android:layout_width="30dp"
        android:layout_height="30dp"
        android:src="@drawable/edit"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        android:layout_marginLeft="250dp"
        android:layout_marginTop="55dp"/>
    <EditText
        android:id="@+id/editar_tituloTreino"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Novo Treinamento"
        android:textSize="25sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        android:layout_marginLeft="20dp"
        android:layout_marginTop="50dp"
        android:textColor="@color/cor_branca"/>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="710dp"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:background="@drawable/borda_arredondada_custom"
        android:backgroundTint="?attr/colorSurface"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        android:layout_marginTop="110dp"
        >

        <!--Botao de novo Exercicio-->
        <LinearLayout
            android:id="@+id/btn_novoExercicio"
            android:layout_width="160dp"
            android:layout_height="30dp"
            android:layout_marginTop="10dp"
            android:gravity="center_vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/cor_azul"
                android:textStyle="bold"
                android:text="+ Novo Exercício"
                android:textSize="20sp"/>
        </LinearLayout>

        <!--Editar Exercicio Adicionado (Depois vai ser adicionado automatico)-->
        <ScrollView
            android:layout_width="280dp"
            android:layout_height="490dp"
            android:layout_marginTop="20dp"
            android:fillViewport="true"
            android:background="@android:color/transparent">

            <LinearLayout
                android:id="@+id/lista_exercicios_adicionados"
                android:layout_width="280dp"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center_horizontal"
                android:padding="10dp"
                />
        </ScrollView>
    </LinearLayout>
    <Button
        android:id="@+id/btn_salvarTreino"
        android:layout_width="205dp"
        android:layout_height="60dp"
        android:text="Salvar"
        android:textSize="20sp"
        android:backgroundTint="@color/cor_azul"
        app:cornerRadius="15dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.95"
        android:textColor="@color/cor_branca"
        />
</androidx.constraintlayout.widget.ConstraintLayout>